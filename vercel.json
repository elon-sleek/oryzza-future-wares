{
    "version": 2,
    "builds": [
        {
            "src": ".output/server/index.mjs",
            "use": "@vercel/node"
        },
        {
            "src": "dist/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/_vercel/insights/(.*)",
            "dest": "/_vercel/insights/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/dist/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": ".output/server/index.mjs"
        }
    ]
}
